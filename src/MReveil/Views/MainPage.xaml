<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Monbsoft.MReveil.Controls"
             xmlns:models="clr-namespace:Monbsoft.MReveil.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Monbsoft.MReveil.ViewModels"
             x:Class="Monbsoft.MReveil.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="MReveil">

    <Grid x:Name="GridLayout" VerticalOptions="FillAndExpand" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="5">
            <Label Text="MReveil" 
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,0"/>
            <Label Text="Stay focused, stay productive" 
                   Style="{StaticResource SubtitleStyle}"
                   Margin="20,0,20,0"/>
        </StackLayout>
        
        <!-- Mode Selector -->
        <StackLayout Grid.Row="1" Padding="16,10,16,20" Spacing="10">
            <HorizontalStackLayout HorizontalOptions="FillAndExpand" Spacing="8">
                <Button x:Name="SetDurationButton" 
                        Command="{Binding SetDurationCommand}"
                        CommandParameter="{x:Static models:ActivityType.Pomodoro}"
                        Text="🍅 Pomodoro"
                        Style="{StaticResource ModeSelectorButtonStyle}"
                        HorizontalOptions="FillAndExpand" />
                <Button Command="{Binding SetDurationCommand}"
                        CommandParameter="{x:Static models:ActivityType.ShortBreak}"
                        Text="☕ Short"
                        Style="{StaticResource ModeSelectorButtonStyle}"
                        HorizontalOptions="FillAndExpand" />
                <Button Command="{Binding SetDurationCommand}"
                        CommandParameter="{x:Static models:ActivityType.LongBreak}"
                        Text="🏖️ Long"
                        Style="{StaticResource ModeSelectorButtonStyle}"
                        HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>
            
            <!-- Current Task Display -->
            <Border Padding="12"
                    StrokeShape="RoundRectangle(8)"
                    Stroke="{StaticResource Primary}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                    IsVisible="{Binding CurrentTask, Converter={StaticResource IsNotNullConverter}}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="🎯 Working on:" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="White"/>
                    <Label Text="{Binding CurrentTask.Title}" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="{Binding CurrentTask.DisplayPomodoros}" 
                           FontSize="12" 
                           TextColor="White"
                           IsVisible="{Binding CurrentTask.PomodorosCount, Converter={StaticResource IsGreaterThanZeroConverter}}"/>
                </VerticalStackLayout>
            </Border>
        </StackLayout>

        <!-- Circular Clock -->
        <controls:CircularClock x:Name="CircularClock"
                                State="{Binding State}"
                                Grid.Row="2"
                                VerticalOptions="CenterAndExpand"
                                HorizontalOptions="Center" />
        
        <!-- Action Buttons -->
        <StackLayout Grid.Row="3" Padding="20,20,20,20" Spacing="12">
            <Button x:Name="StopButton" 
                    Command="{Binding StopCommand}"
                    Text="⏹️ Stop Timer"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    HorizontalOptions="FillAndExpand" />
        </StackLayout>

        <!-- Media Element -->
        <toolkit:MediaElement x:Name="MediaElement"                                                
                              IsVisible="False"
                              ShouldAutoPlay="False"
                              ShouldLoopPlayback="{Binding Settings.LoopPlayback}"
                              ShouldShowPlaybackControls="False"
                              Source="embed://bird.mp3" />
    </Grid>
</ContentPage>