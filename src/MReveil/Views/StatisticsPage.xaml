<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Monbsoft.MReveil.Views.StatisticsPage"
    Title="📊 Statistics">
    
    <Grid RowDefinitions="auto,*" Padding="0">
        
        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="5">
            <Label Text="Statistics" 
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,0"/>
            <Label Text="Track your productivity" 
                   Style="{StaticResource SubtitleStyle}"
                   Margin="20,0,20,0"/>
        </StackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- Streak Card -->
                <Border Padding="24"
                        StrokeShape="RoundRectangle(16)"
                        Stroke="{StaticResource Primary}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray800}}"
                        BorderWidth="2">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="{Binding StreakMessage}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                        <Label Text="{Binding CurrentStreak, StringFormat='Days: {0}'}"
                               FontSize="28"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Primary}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Today Stats -->
                <Border Padding="16"
                        StrokeShape="RoundRectangle(12)"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📅 Today" FontAttributes="Bold" FontSize="16"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="🍅 Pomodoros" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                <Label Text="{Binding TodayPomodoros}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource PomodoroRed}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="⏱️ Focus Time" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                <Label Text="{Binding TodayFocusMinutes, StringFormat='{0}m'}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource BreakGreen}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Weekly Stats -->
                <Border Padding="16"
                        StrokeShape="RoundRectangle(12)"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📊 This Week" FontAttributes="Bold" FontSize="16"/>
                            <Label Text="{Binding WeeklyAverage, StringFormat='Average: {0} per day'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        </VerticalStackLayout>
                        
                        <!-- Weekly Chart Placeholder -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                <BoxView HeightRequest="100" WidthRequest="30" Color="{StaticResource Primary}" CornerRadius="4" VerticalOptions="End"/>
                                <Label Text="Mon" FontSize="10" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                <BoxView HeightRequest="80" WidthRequest="30" Color="{StaticResource Primary}" CornerRadius="4" VerticalOptions="End"/>
                                <Label Text="Tue" FontSize="10" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                <BoxView HeightRequest="60" WidthRequest="30" Color="{StaticResource Primary}" CornerRadius="4" VerticalOptions="End"/>
                                <Label Text="Wed" FontSize="10" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                                <BoxView HeightRequest="90" WidthRequest="30" Color="{StaticResource Primary}" CornerRadius="4" VerticalOptions="End"/>
                                <Label Text="Thu" FontSize="10" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center">
                                <BoxView HeightRequest="100" WidthRequest="30" Color="{StaticResource Primary}" CornerRadius="4" VerticalOptions="End"/>
                                <Label Text="Fri" FontSize="10" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="5" HorizontalOptions="Center">
                                <BoxView HeightRequest="70" WidthRequest="30" Color="{StaticResource Primary}" CornerRadius="4" VerticalOptions="End"/>
                                <Label Text="Sat" FontSize="10" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="6" HorizontalOptions="Center">
                                <BoxView HeightRequest="0" WidthRequest="30" Color="{StaticResource Gray300}" CornerRadius="4" VerticalOptions="End"/>
                                <Label Text="Sun" FontSize="10" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="{Binding WeeklyPomodoros, StringFormat='Total: {0} pomodoros'}"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Primary}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Tips -->
                <Border Padding="16"
                        StrokeShape="RoundRectangle(12)"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray800}}"
                        Stroke="{StaticResource Primary}"
                        BorderWidth="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="💡 Tip" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Primary}"/>
                        <Label Text="Keep your streak alive by completing at least one pomodoro each day. Consistency is key to productivity!"
                               FontSize="12"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
