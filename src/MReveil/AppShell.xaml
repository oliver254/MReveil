<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Monbsoft.MReveil.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Monbsoft.MReveil.Views"
    Shell.FlyoutBehavior="Flyout">

    <ShellContent
        Title="🍅 Timer"
        Icon="timer.png"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="📔 Journal"
        Icon="journal.png"
        ContentTemplate="{DataTemplate views:JournalPage}"
        Route="JournalPage" />
    <ShellContent
        Title="📊 Statistics"
        Icon="stats.png"
        ContentTemplate="{DataTemplate views:StatisticsPage}"
        Route="StatisticsPage" />
    <ShellContent
        Title="⚙️ Settings"
        Icon="settings.png"
        ContentTemplate="{DataTemplate views:SettingsPage}"
        Route="SettingsPage" />

</Shell>
